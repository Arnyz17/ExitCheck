generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  homeAddress   String?
  workAddress   String?
  
  accounts      Account[]
  sessions      Session[]
  gearItems     GearItem[]
  integrations  Integration[]
  nfcTags       NfcTag[]
  actions       QuickAction[]
  scanLogs      ScanLog[]
  devices       DeviceConnection[]
  reminders     Reminder[]
}

model Reminder {
  id        String   @id @default(cuid())
  kind      String   // 'reply' | 'watch'
  title     String   // person to reply to, or what you're watching
  note      String   @default("")
  href      String   @default("")
  avatar    String   @default("")
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceConnection {
  id        String   @id @default(cuid())
  provider  String   // 'home_assistant' | 'govee'
  config    String   // JSON: { url?, token }
  label     String   @default("")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model ScanLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  userId     String
  tagName    String   @default("")
  totalMs    Int
  aiUsed     Boolean  @default(false)
  aiMs       Int      @default(0)
  aiError    String   @default("")
  sources    String   // JSON: [{ name, ms, ok, error? }]
  alertCount Int      @default(0)
  gearCount  Int      @default(0)
  readiness  Int      @default(100)
  alertKinds String   @default("") // comma-separated alert ids
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model NfcTag {
  id            String    @id @default(cuid())
  tagId         String    @unique
  name          String
  location      String    @default("")
  icon          String    @default("door-open")
  items         String    @default("")
  scanCount     Int       @default(0)
  lastScannedAt DateTime?
  createdAt     DateTime  @default(now())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuickAction {
  id        String   @id @default(cuid())
  label     String
  kind      String   // 'webhook' | 'shortcut' | 'link'
  target    String   // webhook URL, Shortcut name, or link URL
  icon      String   @default("power")
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GearItem {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Integration {
  id        String   @id @default(cuid())
  provider  String   // e.g., 'google', 'home_assistant', 'weather'
  status    String   @default("disconnected") // 'connected' or 'disconnected'
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([userId, provider])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  
  access_token       String?  
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  
  session_state      String?
  refresh_token_expires_in Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
